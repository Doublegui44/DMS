// DMS Simulator — Prisma schema
// Conventions: money in Int cents (*Cents), rates in basis points (*Bp),
// labour time in centi-hours, tables mapped to snake_case.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Core: organisation
// ─────────────────────────────────────────────────────────────

model Group {
  id        String   @id @default(cuid())
  name      String
  legalName String
  siren     String?
  vatNumber String?
  createdAt DateTime @default(now())
  sites     Site[]
  brands    Brand[]

  @@map("group")
}

model Country {
  code          String    @id // ISO 3166-1 alpha-2
  name          String
  currency      String    @default("EUR")
  defaultLocale String    @default("fr-FR")
  sites         Site[]
  vatRates      VatRate[]

  @@map("country")
}

model VatRate {
  id          String    @id @default(cuid())
  countryCode String
  code        String // STANDARD, INTERMEDIATE, REDUCED, ZERO
  label       String
  rateBp      Int // 2000 = 20.00 %
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date
  country     Country   @relation(fields: [countryCode], references: [code])

  @@unique([countryCode, code, validFrom])
  @@map("vat_rate")
}

model Site {
  id              String                @id @default(cuid())
  groupId         String
  code            String                @unique // NTE, REN, ANG
  slug            String                @unique // nantes, rennes, angers
  name            String
  address         String
  postalCode      String
  city            String
  countryCode     String
  phone           String?
  siret           String?
  labourRateCents Int // customer labour rate excl. VAT per hour
  createdAt       DateTime              @default(now())
  group           Group                 @relation(fields: [groupId], references: [id])
  country         Country               @relation(fields: [countryCode], references: [code])
  brands          SiteBrand[]
  departments     Department[]
  userRoles       UserRole[]
  vehicles        Vehicle[]
  auditLogs       AuditLog[]
  domainEvents    DomainEvent[]
  settings        Setting[]
  customers       Customer[]            @relation("CustomerHomeSite")
  journalEntries  JournalEntry[]
  invoices        Invoice[]
  payments        Payment[]
  accountMappings AccountMapping[]
  leads           Lead[]
  quotes          Quote[]
  salesOrders     SalesOrder[]
  reservations    Reservation[]
  factoryOrders   FactoryOrder[]
  voPurchases     VoPurchase[]
  policeRegister  PoliceRegisterEntry[]
  commissions     Commission[]

  stockItems       StockItem[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]
  counterSales     CounterSale[]
  transfersOut     StockTransfer[]   @relation("TransferFrom")
  transfersIn      StockTransfer[]   @relation("TransferTo")
  cycleCounts      CycleCount[]

  @@map("site")
}

model Brand {
  id              String           @id @default(cuid())
  groupId         String
  code            String           @unique
  name            String
  oemCustomerId   String?          @unique // OEM as a customer (warranty receivables)
  oemSupplierId   String?          @unique // OEM as a supplier (vehicle & parts purchases)
  wmi             String? // VIN world manufacturer identifier, e.g. VF3
  group           Group            @relation(fields: [groupId], references: [id])
  sites           SiteBrand[]
  vehicles        Vehicle[]
  oemCustomer     Customer?        @relation("BrandOemCustomer", fields: [oemCustomerId], references: [id])
  oemSupplier     Supplier?        @relation("BrandOemSupplier", fields: [oemSupplierId], references: [id])
  accountMappings AccountMapping[]
  catalogueModels CatalogueModel[]

  parts Part[]

  @@map("brand")
}

model SiteBrand {
  siteId  String
  brandId String
  site    Site   @relation(fields: [siteId], references: [id])
  brand   Brand  @relation(fields: [brandId], references: [id])

  @@id([siteId, brandId])
  @@map("site_brand")
}

enum DepartmentCode {
  VN
  VO
  WORKSHOP
  PARTS
  ACCOUNTING
  OVERHEAD
}

model Department {
  id     String         @id @default(cuid())
  siteId String
  code   DepartmentCode
  name   String
  site   Site           @relation(fields: [siteId], references: [id])

  @@unique([siteId, code])
  @@map("department")
}

// ─────────────────────────────────────────────────────────────
// Admin: users, roles, permissions, approvals
// ─────────────────────────────────────────────────────────────

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  isTechnician   Boolean           @default(false)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  roles          UserRole[]
  auditLogs      AuditLog[]
  approvalsMade  ApprovalRequest[] @relation("ApprovalDecider")
  approvalsAsked ApprovalRequest[] @relation("ApprovalRequester")
  leads          Lead[]            @relation("LeadSalesperson")
  quotes         Quote[]           @relation("QuoteSalesperson")
  salesOrders    SalesOrder[]      @relation("OrderSalesperson")
  commissions    Commission[]

  @@map("user")
}

model Role {
  id            String           @id @default(cuid())
  key           String           @unique // ADMIN, DEALER_PRINCIPAL, …
  name          String
  description   String?
  permissions   RolePermission[]
  users         UserRole[]
  approvalRules ApprovalRule[]

  @@map("role")
}

enum PermissionAction {
  view
  create
  edit
  validate
  delete
}

model Permission {
  id       String           @id @default(cuid())
  resource String // e.g. "sales.order"
  action   PermissionAction
  roles    RolePermission[]

  @@unique([resource, action])
  @@map("permission")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

/// A role granted to a user, either on one site or on all sites (siteId = null).
model UserRole {
  id     String  @id @default(cuid())
  userId String
  roleId String
  siteId String?
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id])
  site   Site?   @relation(fields: [siteId], references: [id])

  @@unique([userId, roleId, siteId])
  @@map("user_role")
}

model ApprovalRule {
  id             String            @id @default(cuid())
  key            String // e.g. "deal.discount"
  label          String
  thresholdBp    Int? // percentage threshold in basis points
  thresholdCents Int? // amount threshold
  approverRoleId String
  active         Boolean           @default(true)
  approverRole   Role              @relation(fields: [approverRoleId], references: [id])
  requests       ApprovalRequest[]

  @@unique([key, approverRoleId])
  @@map("approval_rule")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id            String         @id @default(cuid())
  ruleId        String
  entityType    String
  entityId      String
  siteId        String
  status        ApprovalStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  comment       String?
  businessDate  DateTime       @db.Date
  createdAt     DateTime       @default(now())
  rule          ApprovalRule   @relation(fields: [ruleId], references: [id])
  requestedBy   User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedBy     User?          @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([entityType, entityId])
  @@map("approval_request")
}

// ─────────────────────────────────────────────────────────────
// Core: customers
// ─────────────────────────────────────────────────────────────

enum CustomerKind {
  INDIVIDUAL
  COMPANY
  OEM
}

enum PriceClass {
  RETAIL
  TRADE
  INTERNAL
  WARRANTY
}

model Customer {
  id               String        @id @default(cuid())
  number           String        @unique // C000123
  kind             CustomerKind
  // individuals
  title            String?
  firstName        String?
  lastName         String?
  // companies
  companyName      String?
  siren            String?
  vatNumber        String?
  // shared
  displayName      String // denormalised for search & lists
  email            String?
  phone            String?
  address          String?
  postalCode       String?
  city             String?
  countryCode      String        @default("FR")
  priceClass       PriceClass    @default(RETAIL)
  paymentTermsDays Int           @default(0)
  accountCode      String // auxiliary customer account, e.g. 411C000123
  consentEmail     Boolean       @default(false)
  consentSms       Boolean       @default(false)
  consentPhone     Boolean       @default(false)
  homeSiteId       String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  homeSite         Site?         @relation("CustomerHomeSite", fields: [homeSiteId], references: [id])
  contacts         Contact[]
  vehicles         Vehicle[]
  oemOfBrand       Brand?        @relation("BrandOemCustomer")
  invoices         Invoice[]
  payments         Payment[]
  leads            Lead[]
  quotes           Quote[]
  salesOrders      SalesOrder[]
  reservations     Reservation[]
  voPurchases      VoPurchase[]
  counterSales     CounterSale[]

  @@index([displayName])
  @@map("customer")
}

model Contact {
  id         String   @id @default(cuid())
  customerId String
  firstName  String
  lastName   String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("contact")
}

// ─────────────────────────────────────────────────────────────
// Core: vehicles
// ─────────────────────────────────────────────────────────────

enum StockType {
  VN
  VO
  NONE // customer vehicle, not in dealer stock
}

enum VehicleStatus {
  // VN lifecycle
  ORDERED
  IN_TRANSIT
  IN_STOCK
  // VO lifecycle
  INTAKE
  RECONDITIONING
  FOR_SALE
  // shared
  RESERVED
  SOLD
  DELIVERED
  // not in stock (customer-owned, seen in workshop)
  CUSTOMER
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  PLUGIN_HYBRID
  ELECTRIC
  LPG
}

enum VatRegime {
  STANDARD
  MARGIN
}

model Vehicle {
  id                String                 @id @default(cuid())
  vin               String                 @unique
  registration      String?                @unique
  brandId           String?
  make              String // denormalised: works for non-franchise makes too
  model             String
  version           String
  firstRegistration DateTime?              @db.Date
  mileage           Int                    @default(0)
  fuel              FuelType
  co2               Int? // g/km
  powerHp           Int?
  colour            String?
  stockType         StockType
  status            VehicleStatus
  siteId            String?
  ownerCustomerId   String?
  listPriceCents    Int? // selling price incl. VAT for stock vehicles
  stockValueCents   Int                    @default(0)
  stockInDate       DateTime?              @db.Date
  vatRegime         VatRegime              @default(STANDARD)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  brand             Brand?                 @relation(fields: [brandId], references: [id])
  site              Site?                  @relation(fields: [siteId], references: [id])
  owner             Customer?              @relation(fields: [ownerCustomerId], references: [id])
  options           VehicleOption[]
  statusHistory     VehicleStatusHistory[]
  quotes            Quote[]
  salesOrders       SalesOrder[]
  reservations      Reservation[]
  factoryOrder      FactoryOrder?
  voPurchases       VoPurchase[]
  policeEntries     PoliceRegisterEntry[]
  costLines         VehicleCostLine[]
  priceChanges      VoPriceChange[]
  tradeIns          TradeInAppraisal[]

  @@index([status, stockType])
  @@index([siteId])
  @@map("vehicle")
}

model VehicleOption {
  id         String  @id @default(cuid())
  vehicleId  String
  code       String
  label      String
  priceCents Int     @default(0)
  vehicle    Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_option")
}

model VehicleStatusHistory {
  id           String         @id @default(cuid())
  vehicleId    String
  fromStatus   VehicleStatus?
  toStatus     VehicleStatus
  businessDate DateTime       @db.Date
  userId       String?
  reason       String?
  createdAt    DateTime       @default(now())
  vehicle      Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_status_history")
}

// ─────────────────────────────────────────────────────────────
// Core: numbering, audit, events, clock, settings
// ─────────────────────────────────────────────────────────────

/// Gap-free counter. scope = site id, or "GROUP" for group-wide series.
model DocumentSequence {
  scope      String
  docType    String // INVOICE, CREDIT_NOTE, CUSTOMER, SALES_ORDER, RO, …
  fiscalYear Int // 0 for series that never reset
  prefix     String
  padding    Int    @default(6)
  nextValue  Int    @default(1)

  @@id([scope, docType, fiscalYear])
  @@map("document_sequence")
}

model AuditLog {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  businessDate DateTime @db.Date
  userId       String?
  siteId       String?
  action       String // e.g. "customer.create"
  entityType   String
  entityId     String
  before       Json?
  after        Json?
  user         User?    @relation(fields: [userId], references: [id])
  site         Site?    @relation(fields: [siteId], references: [id])

  @@index([entityType, entityId])
  @@index([at])
  @@map("audit_log")
}

model DomainEvent {
  id            String   @id @default(cuid())
  type          String
  siteId        String?
  aggregateType String
  aggregateId   String
  payload       Json
  businessDate  DateTime @db.Date
  userId        String?
  createdAt     DateTime @default(now())
  site          Site?    @relation(fields: [siteId], references: [id])

  @@index([aggregateType, aggregateId])
  @@index([type])
  @@map("domain_event")
}

model BusinessClock {
  id          Int      @id @default(1)
  currentDate DateTime @db.Date
  updatedAt   DateTime @updatedAt

  @@map("business_clock")
}

/// Key/value settings. siteId = null means group-wide default.
model Setting {
  id     String  @id @default(cuid())
  key    String
  siteId String?
  value  Json
  site   Site?   @relation(fields: [siteId], references: [id])

  @@unique([key, siteId])
  @@map("setting")
}

// ─────────────────────────────────────────────────────────────
// Core: suppliers (payables party; purchasing documents arrive in Phase 4)
// ─────────────────────────────────────────────────────────────

model Supplier {
  id               String            @id @default(cuid())
  number           String            @unique // F00012
  name             String
  isOem            Boolean           @default(false)
  siren            String?
  vatNumber        String?
  email            String?
  phone            String?
  address          String?
  postalCode       String?
  city             String?
  countryCode      String            @default("FR")
  paymentTermsDays Int               @default(30)
  accountCode      String // auxiliary code, e.g. 401F00012
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  oemOfBrand       Brand?            @relation("BrandOemSupplier")
  payments         Payment[]
  voPurchases      VoPurchase[]
  vehicleCosts     VehicleCostLine[]

  parts            Part[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  supplierInvoices SupplierInvoice[]

  @@map("supplier")
}

// ─────────────────────────────────────────────────────────────
// Accounting
// ─────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// Chart of accounts (PCG by default, configurable).
model Account {
  code             String           @id // e.g. "707100"
  label            String
  class            Int // first digit, 1..8
  type             AccountType
  postable         Boolean          @default(true)
  requiresAnalytic Boolean          @default(false) // classes 6/7 need a department
  isReceivable     Boolean          @default(false) // lines need a CUSTOMER party
  isPayable        Boolean          @default(false) // lines need a SUPPLIER party
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  lines            JournalLine[]
  mappings         AccountMapping[]

  @@map("account")
}

enum JournalKind {
  SALES
  PURCHASES
  BANK
  CASH
  MISC
  OPENING
}

model Journal {
  code        String         @id // VE, AC, BQ, CA, OD, AN
  label       String
  kind        JournalKind
  /// Treasury account for BANK/CASH journals (counterpart of payments).
  accountCode String?
  entries     JournalEntry[]
  payments    Payment[]

  @@map("journal")
}

enum PeriodStatus {
  OPEN
  LOCKED
}

model FiscalPeriod {
  id         String         @id @default(cuid())
  year       Int
  month      Int
  startDate  DateTime       @db.Date
  endDate    DateTime       @db.Date
  status     PeriodStatus   @default(OPEN)
  lockedAt   DateTime?
  lockedById String?
  entries    JournalEntry[]

  @@unique([year, month])
  @@map("fiscal_period")
}

/// Posted entries are immutable; corrections are reversal entries.
model JournalEntry {
  id           String        @id @default(cuid())
  number       String        @unique // VE-2026-000123, gap-free per journal & year
  journalCode  String
  periodId     String
  siteId       String
  entryDate    DateTime      @db.Date
  label        String
  sourceType   String? // INVOICE, PAYMENT, MANUAL, OPENING, REVERSAL…
  sourceId     String?
  reversalOfId String?       @unique
  createdById  String?
  createdAt    DateTime      @default(now())
  journal      Journal       @relation(fields: [journalCode], references: [code])
  period       FiscalPeriod  @relation(fields: [periodId], references: [id])
  site         Site          @relation(fields: [siteId], references: [id])
  reversalOf   JournalEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("EntryReversal")
  lines        JournalLine[]

  @@index([sourceType, sourceId])
  @@index([entryDate])
  @@map("journal_entry")
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

model JournalLine {
  id             String          @id @default(cuid())
  entryId        String
  lineNo         Int
  accountCode    String
  departmentCode DepartmentCode?
  partyType      PartyType?
  partyId        String?
  debitCents     Int             @default(0)
  creditCents    Int             @default(0)
  label          String
  letteringCode  String?
  // denormalised from the entry for fast reporting
  siteId         String
  entryDate      DateTime        @db.Date
  entry          JournalEntry    @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account        Account         @relation(fields: [accountCode], references: [code])

  @@unique([entryId, lineNo])
  @@index([accountCode, entryDate])
  @@index([partyType, partyId])
  @@map("journal_line")
}

/// Posting key → account. Most specific wins: site + brand → site → brand → global.
model AccountMapping {
  id          String  @id @default(cuid())
  key         String // e.g. REVENUE_VN, VAT_COLLECTED_STANDARD
  siteId      String?
  brandId     String?
  accountCode String
  site        Site?   @relation(fields: [siteId], references: [id])
  brand       Brand?  @relation(fields: [brandId], references: [id])
  account     Account @relation(fields: [accountCode], references: [code])

  @@index([key])
  @@map("account_mapping")
}

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
}

/// One table for every sales invoice and credit note (D-013). Numbered only at issue.
model Invoice {
  id                String              @id @default(cuid())
  number            String?             @unique
  kind              InvoiceKind         @default(INVOICE)
  sourceType        String // MANUAL, SALES_ORDER, REPAIR_ORDER, COUNTER_SALE, WARRANTY_CLAIM
  sourceId          String?
  siteId            String
  customerId        String
  vatRegime         VatRegime           @default(STANDARD)
  status            InvoiceStatus       @default(DRAFT)
  issueDate         DateTime?           @db.Date
  dueDate           DateTime?           @db.Date
  totalExclVatCents Int                 @default(0)
  vatCents          Int                 @default(0)
  totalInclVatCents Int                 @default(0)
  paidCents         Int                 @default(0)
  creditedInvoiceId String?
  journalEntryId    String?             @unique
  notes             String?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  site              Site                @relation(fields: [siteId], references: [id])
  customer          Customer            @relation(fields: [customerId], references: [id])
  creditedInvoice   Invoice?            @relation("CreditNoteOf", fields: [creditedInvoiceId], references: [id])
  creditNotes       Invoice[]           @relation("CreditNoteOf")
  lines             InvoiceLine[]
  allocations       PaymentAllocation[]
  salesOrder        SalesOrder?
  counterSale       CounterSale?

  @@index([customerId, status])
  @@index([sourceType, sourceId])
  @@map("invoice")
}

model InvoiceLine {
  id                    String         @id @default(cuid())
  invoiceId             String
  lineNo                Int
  label                 String
  quantity              Decimal        @db.Decimal(12, 3)
  unitPriceExclVatCents Int
  discountBp            Int            @default(0)
  lineExclVatCents      Int
  vatRateCode           String
  vatRateBp             Int
  vatCents              Int
  vatRegime             VatRegime      @default(STANDARD) // MARGIN = VAT on the margin (used vehicle)
  departmentCode        DepartmentCode
  revenueKey            String // AccountMapping key, e.g. REVENUE_LABOUR
  invoice               Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNo])
  @@map("invoice_line")
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentMethod {
  TRANSFER
  CARD
  CHEQUE
  CASH
  FINANCE_COMPANY
  TRADE_IN // payment in kind: the customer's trade-in offsets the invoice
}

model Payment {
  id             String              @id @default(cuid())
  number         String              @unique
  siteId         String
  direction      PaymentDirection
  method         PaymentMethod
  journalCode    String
  customerId     String?
  supplierId     String?
  amountCents    Int
  allocatedCents Int                 @default(0)
  businessDate   DateTime            @db.Date
  reference      String?
  sourceType     String? // e.g. SALES_ORDER for a deposit taken on an order
  sourceId       String?
  journalEntryId String?             @unique
  createdById    String?
  createdAt      DateTime            @default(now())
  site           Site                @relation(fields: [siteId], references: [id])
  journal        Journal             @relation(fields: [journalCode], references: [code])
  customer       Customer?           @relation(fields: [customerId], references: [id])
  supplier       Supplier?           @relation(fields: [supplierId], references: [id])
  allocations    PaymentAllocation[]

  @@index([customerId])
  @@index([supplierId])
  @@index([sourceType, sourceId])
  @@map("payment")
}

model PaymentAllocation {
  id          String   @id @default(cuid())
  paymentId   String
  invoiceId   String
  amountCents Int
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id])
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])

  @@map("payment_allocation")
}

// ─────────────────────────────────────────────────────────────
// Sales VN / VO: catalogue, pipeline, orders, stock
// ─────────────────────────────────────────────────────────────

enum CatalogueOptionKind {
  PAINT
  PACK
  EQUIPMENT
}

model CatalogueModel {
  id       String             @id @default(cuid())
  brandId  String
  name     String
  active   Boolean            @default(true)
  brand    Brand              @relation(fields: [brandId], references: [id])
  versions CatalogueVersion[]

  @@unique([brandId, name])
  @@map("catalogue_model")
}

/// OEM catalogue version. Prices are excl. VAT; dealer cost is what the OEM invoices.
model CatalogueVersion {
  id                    String            @id @default(cuid())
  modelId               String
  code                  String            @unique
  name                  String
  fuel                  FuelType
  co2                   Int // g/km
  powerHp               Int
  listPriceExclVatCents Int
  dealerCostCents       Int
  oemIncentiveCents     Int               @default(0) // OEM-funded customer incentive, excl. VAT
  leadTimeDays          Int               @default(45)
  active                Boolean           @default(true)
  model                 CatalogueModel    @relation(fields: [modelId], references: [id])
  options               CatalogueOption[]
  quotes                Quote[]
  factoryOrders         FactoryOrder[]

  @@map("catalogue_version")
}

model CatalogueOption {
  id                    String              @id @default(cuid())
  versionId             String
  code                  String
  label                 String
  kind                  CatalogueOptionKind
  listPriceExclVatCents Int
  dealerCostCents       Int
  version               CatalogueVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, code])
  @@map("catalogue_option")
}

enum AddOnKind {
  WARRANTY
  MAINTENANCE
}

/// Add-on products sold with a vehicle (back-end margin).
model AddOnProduct {
  id                String    @id @default(cuid())
  code              String    @unique
  kind              AddOnKind
  name              String
  months            Int
  priceExclVatCents Int
  costCents         Int
  active            Boolean   @default(true)

  @@map("add_on_product")
}

enum LeadSource {
  WALK_IN
  PHONE
  WEB
  REFERRAL
  RETURNING
  EVENT
}

enum LeadStage {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model Lead {
  id            String       @id @default(cuid())
  number        String       @unique
  siteId        String
  customerId    String
  salespersonId String?
  source        LeadSource
  interest      StockType // VN or VO
  stage         LeadStage    @default(NEW)
  description   String?
  lostReason    String?
  openedOn      DateTime     @db.Date
  closedOn      DateTime?    @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  site          Site         @relation(fields: [siteId], references: [id])
  customer      Customer     @relation(fields: [customerId], references: [id])
  salesperson   User?        @relation("LeadSalesperson", fields: [salespersonId], references: [id])
  quotes        Quote[]
  salesOrders   SalesOrder[]

  @@index([siteId, stage])
  @@map("lead")
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

/// A priced deal offered to the customer. Totals are a snapshot computed by the pricing domain.
model Quote {
  id                    String            @id @default(cuid())
  number                String            @unique
  leadId                String
  siteId                String
  customerId            String
  salespersonId         String?
  stockType             StockType // VN or VO
  vehicleId             String? // a stock vehicle (VN in stock or on order, VO for sale)
  catalogueVersionId    String? // or a VN to order from the OEM
  colour                String?
  status                QuoteStatus       @default(DRAFT)
  vatRegime             VatRegime         @default(STANDARD)
  createdOn             DateTime          @db.Date
  validUntil            DateTime          @db.Date
  listPriceInclVatCents Int               @default(0) // vehicle + options at list price
  discountInclVatCents  Int               @default(0) // dealer discount as shown to the customer
  discountBp            Int               @default(0) // effective discount (incl. trade-in over-allowance)
  totalExclVatCents     Int               @default(0)
  vatCents              Int               @default(0)
  totalInclVatCents     Int               @default(0)
  tradeInCents          Int               @default(0)
  financedCents         Int               @default(0)
  balanceDueCents       Int               @default(0)
  frontEndMarginCents   Int               @default(0)
  backEndMarginCents    Int               @default(0)
  commissionCents       Int               @default(0)
  sentOn                DateTime?         @db.Date
  decidedOn             DateTime?         @db.Date
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  lead                  Lead              @relation(fields: [leadId], references: [id])
  site                  Site              @relation(fields: [siteId], references: [id])
  customer              Customer          @relation(fields: [customerId], references: [id])
  salesperson           User?             @relation("QuoteSalesperson", fields: [salespersonId], references: [id])
  vehicle               Vehicle?          @relation(fields: [vehicleId], references: [id])
  catalogueVersion      CatalogueVersion? @relation(fields: [catalogueVersionId], references: [id])
  lines                 DealLine[]
  tradeIn               TradeInAppraisal?
  financing             FinancingPlan?
  salesOrder            SalesOrder?
  reservations          Reservation[]

  @@index([siteId, status])
  @@index([leadId])
  @@map("quote")
}

enum DealLineKind {
  VEHICLE
  OPTION
  ACCESSORY
  DISCOUNT
  OEM_INCENTIVE
  ECO_BONUS
  ECO_MALUS
  REGISTRATION_FEE
  ADDON
}

enum DealVatMode {
  STANDARD // price excl. VAT, VAT at the standard rate
  MARGIN // price incl. VAT, VAT due on the margin only (used vehicle)
  NONE // outside the scope of VAT: taxes, pass-through fees, State bonus
}

model DealLine {
  id                 String       @id @default(cuid())
  quoteId            String
  lineNo             Int
  kind               DealLineKind
  label              String
  quantity           Int          @default(1)
  unitPriceCents     Int // excl. VAT; incl. VAT for MARGIN lines
  unitCostCents      Int          @default(0)
  purchasePriceCents Int? // MARGIN lines: purchase price, base of the margin VAT
  vatMode            DealVatMode
  vatRateBp          Int
  lineExclVatCents   Int
  vatCents           Int
  lineInclVatCents   Int
  catalogueOptionId  String?
  addOnProductId     String?
  quote              Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, lineNo])
  @@map("deal_line")
}

/// Appraisal of the customer's car taken in part-exchange. At order confirmation it becomes a VO in INTAKE.
model TradeInAppraisal {
  id                   String    @id @default(cuid())
  quoteId              String    @unique
  vehicleId            String? // the customer's car if already known, then the VO record
  vin                  String
  registration         String?
  make                 String
  model                String
  version              String
  firstRegistration    DateTime? @db.Date
  mileage              Int
  fuel                 FuelType
  marketValueCents     Int
  estimatedRepairCents Int       @default(0)
  offerCents           Int
  notes                String?
  quote                Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  vehicle              Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@map("trade_in_appraisal")
}

enum FinancingKind {
  LOAN
  LEASE
}

model FinancingPlan {
  id                    String        @id @default(cuid())
  quoteId               String        @unique
  kind                  FinancingKind
  lender                String
  depositCents          Int
  principalCents        Int
  aprBp                 Int
  months                Int
  residualCents         Int           @default(0)
  monthlyPaymentCents   Int
  totalCostCents        Int // cost of credit
  totalPayableCents     Int
  dealerCommissionCents Int
  quote                 Quote         @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("financing_plan")
}

enum SalesOrderStatus {
  CONFIRMED
  INVOICED
  DELIVERED
  CANCELLED
}

/// Signed order form (bon de commande). A vehicle is on at most one open order (partial unique index).
model SalesOrder {
  id                   String           @id @default(cuid())
  number               String           @unique
  quoteId              String           @unique
  leadId               String
  siteId               String
  customerId           String
  salespersonId        String?
  vehicleId            String
  stockType            StockType
  status               SalesOrderStatus @default(CONFIRMED)
  orderDate            DateTime         @db.Date
  expectedDeliveryDate DateTime?        @db.Date
  totalInclVatCents    Int
  tradeInCents         Int              @default(0)
  financedCents        Int              @default(0)
  frontEndMarginCents  Int              @default(0)
  backEndMarginCents   Int              @default(0)
  invoiceId            String?          @unique
  invoicedOn           DateTime?        @db.Date
  deliveredOn          DateTime?        @db.Date
  deliveryMileage      Int?
  cancelledOn          DateTime?        @db.Date
  cancelReason         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  quote                Quote            @relation(fields: [quoteId], references: [id])
  lead                 Lead             @relation(fields: [leadId], references: [id])
  site                 Site             @relation(fields: [siteId], references: [id])
  customer             Customer         @relation(fields: [customerId], references: [id])
  salesperson          User?            @relation("OrderSalesperson", fields: [salespersonId], references: [id])
  vehicle              Vehicle          @relation(fields: [vehicleId], references: [id])
  invoice              Invoice?         @relation(fields: [invoiceId], references: [id])
  factoryOrder         FactoryOrder?
  commission           Commission?
  voPurchases          VoPurchase[]

  @@index([siteId, status])
  @@map("sales_order")
}

enum FactoryOrderStatus {
  ORDERED
  IN_TRANSIT
  ARRIVED
  CANCELLED
}

/// VN ordered from the OEM, for a customer order or for stock.
model FactoryOrder {
  id                 String             @id @default(cuid())
  number             String             @unique
  siteId             String
  catalogueVersionId String
  vehicleId          String             @unique
  salesOrderId       String?            @unique // null = ordered for stock
  oemReference       String
  status             FactoryOrderStatus @default(ORDERED)
  orderedOn          DateTime           @db.Date
  expectedOn         DateTime           @db.Date
  shippedOn          DateTime?          @db.Date
  arrivedOn          DateTime?          @db.Date
  createdAt          DateTime           @default(now())
  site               Site               @relation(fields: [siteId], references: [id])
  catalogueVersion   CatalogueVersion   @relation(fields: [catalogueVersionId], references: [id])
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id])
  salesOrder         SalesOrder?        @relation(fields: [salesOrderId], references: [id])

  @@index([siteId, status])
  @@map("factory_order")
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

/// Holds a stock vehicle for a customer for N days. One ACTIVE reservation per vehicle (partial unique index).
model Reservation {
  id             String            @id @default(cuid())
  vehicleId      String
  siteId         String
  quoteId        String?
  customerId     String
  reservedById   String?
  previousStatus VehicleStatus
  reservedOn     DateTime          @db.Date
  expiresOn      DateTime          @db.Date
  status         ReservationStatus @default(ACTIVE)
  closedOn       DateTime?         @db.Date
  createdAt      DateTime          @default(now())
  vehicle        Vehicle           @relation(fields: [vehicleId], references: [id])
  site           Site              @relation(fields: [siteId], references: [id])
  quote          Quote?            @relation(fields: [quoteId], references: [id])
  customer       Customer          @relation(fields: [customerId], references: [id])

  @@index([status, expiresOn])
  @@index([vehicleId])
  @@map("reservation")
}

enum CommissionStatus {
  EARNED
  PAID
}

model Commission {
  id            String           @id @default(cuid())
  salesOrderId  String           @unique
  userId        String
  siteId        String
  frontEndCents Int
  addOnCents    Int
  financeCents  Int
  amountCents   Int
  earnedOn      DateTime         @db.Date
  status        CommissionStatus @default(EARNED)
  salesOrder    SalesOrder       @relation(fields: [salesOrderId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
  site          Site             @relation(fields: [siteId], references: [id])

  @@map("commission")
}

enum VoPurchaseSource {
  TRADE_IN
  PRIVATE
  PROFESSIONAL
  OPENING // stock already held when the books were opened
}

/// How a used vehicle entered stock. Margin-regime VAT base = sale price incl. VAT − priceCents.
model VoPurchase {
  id                String               @id @default(cuid())
  number            String               @unique
  siteId            String
  vehicleId         String
  source            VoPurchaseSource
  customerId        String? // private seller / trade-in customer
  supplierId        String? // professional seller
  salesOrderId      String? // trade-in taken on this order
  priceCents        Int // purchase price excl. deductible VAT
  vatCents          Int                  @default(0) // deductible VAT (professional, standard regime)
  vatRegime         VatRegime // regime of the resale
  purchaseDate      DateTime             @db.Date
  supplierReference String?
  cancelledOn       DateTime?            @db.Date // trade-in handed back when its order was cancelled
  createdAt         DateTime             @default(now())
  site              Site                 @relation(fields: [siteId], references: [id])
  vehicle           Vehicle              @relation(fields: [vehicleId], references: [id])
  customer          Customer?            @relation(fields: [customerId], references: [id])
  supplier          Supplier?            @relation(fields: [supplierId], references: [id])
  salesOrder        SalesOrder?          @relation(fields: [salesOrderId], references: [id])
  policeEntry       PoliceRegisterEntry?

  @@index([vehicleId])
  @@map("vo_purchase")
}

/// Livre de police: register of used vehicles bought and sold, numbered per site.
model PoliceRegisterEntry {
  id                 String     @id @default(cuid())
  number             String     @unique
  siteId             String
  vehicleId          String
  voPurchaseId       String     @unique
  inDate             DateTime   @db.Date
  description        String
  vin                String
  registration       String?
  sellerName         String
  sellerAddress      String?
  purchasePriceCents Int
  outDate            DateTime?  @db.Date
  buyerName          String?
  buyerAddress       String?
  salePriceCents     Int?
  saleReference      String?
  createdAt          DateTime   @default(now())
  site               Site       @relation(fields: [siteId], references: [id])
  vehicle            Vehicle    @relation(fields: [vehicleId], references: [id])
  voPurchase         VoPurchase @relation(fields: [voPurchaseId], references: [id])

  @@index([siteId, inDate])
  @@map("police_register_entry")
}

enum VehicleCostKind {
  RECONDITIONING
  TRANSPORT
  OTHER
}

/// Costs capitalised into a used vehicle's stock value (purchase price + Σ cost lines).
model VehicleCostLine {
  id           String          @id @default(cuid())
  vehicleId    String
  kind         VehicleCostKind
  label        String
  amountCents  Int // excl. VAT
  supplierId   String?
  sourceType   String          @default("MANUAL") // MANUAL, REPAIR_ORDER (Phase 5)
  sourceId     String?
  businessDate DateTime        @db.Date
  createdById  String?
  createdAt    DateTime        @default(now())
  vehicle      Vehicle         @relation(fields: [vehicleId], references: [id])
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])

  @@index([vehicleId])
  @@map("vehicle_cost_line")
}

model VoPriceChange {
  id            String   @id @default(cuid())
  vehicleId     String
  oldPriceCents Int?
  newPriceCents Int
  reason        String?
  businessDate  DateTime @db.Date
  userId        String?
  createdAt     DateTime @default(now())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@map("vo_price_change")
}

// ─────────────────────────────────────────────────────────────
// Parts (Phase 4)
// ─────────────────────────────────────────────────────────────

model DiscountCode {
  id    String         @id @default(cuid())
  code  String         @unique
  label String
  rates DiscountRate[]
  parts Part[]

  @@map("discount_code")
}

/// The discount matrix: one rate per discount code and customer price class.
model DiscountRate {
  id             String       @id @default(cuid())
  discountCodeId String
  priceClass     PriceClass
  discountBp     Int
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, priceClass])
  @@map("discount_rate")
}

model Part {
  id               String              @id @default(cuid())
  partNumber       String              @unique
  description      String
  family           String
  brandId          String? // OEM part of this brand; null for aftermarket and consumables
  supplierId       String // usual supplier (the brand's OEM for OEM parts)
  discountCodeId   String
  unit             String              @default("EA") // EA, L, M
  retailPriceCents Int // excl. VAT
  listCostCents    Int // supplier price excl. VAT, used on purchase orders
  vatRateCode      String              @default("STANDARD")
  active           Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  brand            Brand?              @relation(fields: [brandId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  discountCode     DiscountCode        @relation(fields: [discountCodeId], references: [id])
  stock            StockItem[]
  replacedBy       PartSupersession?   @relation("SupersededPart")
  replaces         PartSupersession[]  @relation("ReplacementPart")
  poLines          PurchaseOrderLine[]
  counterLines     CounterSaleLine[]
  transferLines    StockTransferLine[]

  @@index([brandId])
  @@index([family])
  @@map("part")
}

model PartSupersession {
  id          String   @id @default(cuid())
  oldPartId   String   @unique
  newPartId   String
  effectiveOn DateTime @db.Date
  createdAt   DateTime @default(now())
  oldPart     Part     @relation("SupersededPart", fields: [oldPartId], references: [id])
  newPart     Part     @relation("ReplacementPart", fields: [newPartId], references: [id])

  @@index([newPartId])
  @@map("part_supersession")
}

/// A part held at a site. `valueCents` is the sum of its movements' values, so the parts stock
/// account always equals the sub-ledger; `pmpCents` is the weighted average cost per unit.
model StockItem {
  id             String           @id @default(cuid())
  partId         String
  siteId         String
  bin            String?
  qtyOnHand      Decimal          @default(0) @db.Decimal(12, 3)
  qtyReserved    Decimal          @default(0) @db.Decimal(12, 3)
  valueCents     Int              @default(0)
  pmpCents       Decimal          @default(0) @db.Decimal(18, 4)
  minQty         Decimal          @default(0) @db.Decimal(12, 3)
  maxQty         Decimal          @default(0) @db.Decimal(12, 3)
  lastMovementOn DateTime?        @db.Date
  lastCountedOn  DateTime?        @db.Date
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  part           Part             @relation(fields: [partId], references: [id])
  site           Site             @relation(fields: [siteId], references: [id])
  movements      PartMovement[]
  countLines     CycleCountLine[]

  @@unique([partId, siteId])
  @@index([siteId])
  @@map("stock_item")
}

enum PartMovementKind {
  OPENING
  RECEIPT
  ISSUE_RO
  COUNTER_SALE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
  RETURN_SUPPLIER
  RETURN_CUSTOMER
}

/// The parts stock ledger: one row per movement, signed quantities and values.
model PartMovement {
  id              String           @id @default(cuid())
  stockItemId     String
  partId          String
  siteId          String
  kind            PartMovementKind
  qty             Decimal          @db.Decimal(12, 3)
  unitCostCents   Decimal          @db.Decimal(18, 4)
  valueCents      Int
  qtyAfter        Decimal          @db.Decimal(12, 3)
  valueAfterCents Int
  pmpAfterCents   Decimal          @db.Decimal(18, 4)
  sourceType      String
  sourceId        String?
  reference       String?
  businessDate    DateTime         @db.Date
  userId          String?
  createdAt       DateTime         @default(now())
  stockItem       StockItem        @relation(fields: [stockItemId], references: [id])

  @@index([stockItemId, createdAt])
  @@index([siteId, businessDate])
  @@index([sourceType, sourceId])
  @@map("part_movement")
}

enum PurchaseOrderKind {
  STOCK
  EMERGENCY
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  siteId      String
  supplierId  String
  kind        PurchaseOrderKind   @default(STOCK)
  status      PurchaseOrderStatus @default(DRAFT)
  createdOn   DateTime            @db.Date
  sentOn      DateTime?           @db.Date
  expectedOn  DateTime?           @db.Date
  closedOn    DateTime?           @db.Date
  notes       String?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  site        Site                @relation(fields: [siteId], references: [id])
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  lines       PurchaseOrderLine[]
  receipts    GoodsReceipt[]

  @@index([siteId, status])
  @@index([supplierId])
  @@map("purchase_order")
}

model PurchaseOrderLine {
  id              String             @id @default(cuid())
  purchaseOrderId String
  lineNo          Int
  partId          String
  qtyOrdered      Decimal            @db.Decimal(12, 3)
  qtyReceived     Decimal            @default(0) @db.Decimal(12, 3)
  unitCostCents   Int
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  part            Part               @relation(fields: [partId], references: [id])
  receiptLines    GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  @@index([partId])
  @@map("purchase_order_line")
}

model GoodsReceipt {
  id              String             @id @default(cuid())
  number          String             @unique
  siteId          String
  purchaseOrderId String
  supplierId      String
  receivedOn      DateTime           @db.Date
  deliveryNote    String?
  valueCents      Int
  createdById     String?
  createdAt       DateTime           @default(now())
  site            Site               @relation(fields: [siteId], references: [id])
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier           @relation(fields: [supplierId], references: [id])
  lines           GoodsReceiptLine[]

  @@index([supplierId, siteId])
  @@map("goods_receipt")
}

model GoodsReceiptLine {
  id            String                @id @default(cuid())
  receiptId     String
  poLineId      String
  partId        String
  qty           Decimal               @db.Decimal(12, 3)
  unitCostCents Int
  valueCents    Int
  qtyInvoiced   Decimal               @default(0) @db.Decimal(12, 3)
  receipt       GoodsReceipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  poLine        PurchaseOrderLine     @relation(fields: [poLineId], references: [id])
  invoiceLines  SupplierInvoiceLine[]

  @@map("goods_receipt_line")
}

enum SupplierInvoiceStatus {
  VARIANCE
  MATCHED
  PAID
  REJECTED
}

/// A supplier's invoice matched to goods receipts. Posted when matched (or when a variance is approved).
model SupplierInvoice {
  id                String                @id @default(cuid())
  number            String                @unique
  siteId            String
  supplierId        String
  supplierReference String
  invoiceDate       DateTime              @db.Date
  dueDate           DateTime              @db.Date
  status            SupplierInvoiceStatus
  totalExclVatCents Int
  vatCents          Int
  totalInclVatCents Int
  receiptValueCents Int
  varianceCents     Int
  entryId           String?
  paymentId         String?
  decidedById       String?
  decidedOn         DateTime?             @db.Date
  notes             String?
  createdById       String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  site              Site                  @relation(fields: [siteId], references: [id])
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  lines             SupplierInvoiceLine[]

  @@unique([supplierId, supplierReference])
  @@index([siteId, status])
  @@map("supplier_invoice")
}

model SupplierInvoiceLine {
  id                String           @id @default(cuid())
  invoiceId         String
  receiptLineId     String
  partId            String
  qty               Decimal          @db.Decimal(12, 3)
  unitCostCents     Int
  amountCents       Int
  receiptValueCents Int
  varianceCents     Int
  invoice           SupplierInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptLine       GoodsReceiptLine @relation(fields: [receiptLineId], references: [id])

  @@map("supplier_invoice_line")
}

enum CounterSaleStatus {
  QUOTE
  CONFIRMED
  INVOICED
  CANCELLED
}

model CounterSale {
  id                String            @id @default(cuid())
  number            String            @unique
  siteId            String
  customerId        String
  priceClass        PriceClass
  status            CounterSaleStatus @default(QUOTE)
  reference         String?
  createdOn         DateTime          @db.Date
  confirmedOn       DateTime?         @db.Date
  invoicedOn        DateTime?         @db.Date
  cancelledOn       DateTime?         @db.Date
  invoiceId         String?           @unique
  totalExclVatCents Int               @default(0)
  costCents         Int               @default(0)
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  site              Site              @relation(fields: [siteId], references: [id])
  customer          Customer          @relation(fields: [customerId], references: [id])
  invoice           Invoice?          @relation(fields: [invoiceId], references: [id])
  lines             CounterSaleLine[]

  @@index([siteId, status])
  @@index([customerId])
  @@map("counter_sale")
}

model CounterSaleLine {
  id               String      @id @default(cuid())
  saleId           String
  lineNo           Int
  partId           String
  qty              Decimal     @db.Decimal(12, 3)
  unitPriceCents   Int
  discountBp       Int
  lineExclVatCents Int
  unitCostCents    Decimal?    @db.Decimal(18, 4)
  costCents        Int?
  requestedNumber  String? // the number asked for when it was superseded
  sale             CounterSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  part             Part        @relation(fields: [partId], references: [id])

  @@unique([saleId, lineNo])
  @@map("counter_sale_line")
}

model StockTransfer {
  id            String              @id @default(cuid())
  number        String              @unique
  fromSiteId    String
  toSiteId      String
  transferredOn DateTime            @db.Date
  valueCents    Int
  notes         String?
  createdById   String?
  createdAt     DateTime            @default(now())
  fromSite      Site                @relation("TransferFrom", fields: [fromSiteId], references: [id])
  toSite        Site                @relation("TransferTo", fields: [toSiteId], references: [id])
  lines         StockTransferLine[]

  @@map("stock_transfer")
}

model StockTransferLine {
  id            String        @id @default(cuid())
  transferId    String
  partId        String
  qty           Decimal       @db.Decimal(12, 3)
  unitCostCents Decimal       @db.Decimal(18, 4)
  valueCents    Int
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  part          Part          @relation(fields: [partId], references: [id])

  @@map("stock_transfer_line")
}

enum CycleCountStatus {
  OPEN
  POSTED
  CANCELLED
}

model CycleCount {
  id                 String           @id @default(cuid())
  number             String           @unique
  siteId             String
  status             CycleCountStatus @default(OPEN)
  label              String
  createdOn          DateTime         @db.Date
  postedOn           DateTime?        @db.Date
  varianceValueCents Int              @default(0)
  createdById        String?
  postedById         String?
  createdAt          DateTime         @default(now())
  site               Site             @relation(fields: [siteId], references: [id])
  lines              CycleCountLine[]

  @@index([siteId, status])
  @@map("cycle_count")
}

model CycleCountLine {
  id                 String     @id @default(cuid())
  countId            String
  stockItemId        String
  expectedQty        Decimal    @db.Decimal(12, 3)
  countedQty         Decimal?   @db.Decimal(12, 3)
  varianceQty        Decimal?   @db.Decimal(12, 3)
  varianceValueCents Int?
  count              CycleCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  stockItem          StockItem  @relation(fields: [stockItemId], references: [id])

  @@unique([countId, stockItemId])
  @@map("cycle_count_line")
}
